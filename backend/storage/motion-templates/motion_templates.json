[
  {
    "id": "mot-1791090372279",
    "name": "Counter",
    "description": "Custom unified HTML & CSS animation template.",
    "category": "metrics",
    "width": 600,
    "height": 220,
    "code": "<style>\n  @property --num {\n    syntax: \"<integer>\";\n    initial-value: 0;\n    inherits: false;\n  }\n\n  .custom-counter {\n    --start: {{start}};\n    --end: {{end}};\n    --seconds: {{seconds}}s;\n    --counter-color: {{color}};\n\n    width: 100%;\n    height: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    font-size: {{font_size}}px;\n    font-weight: 800;\n    line-height: 1;\n\n    color: var(--counter-color);\n\n    counter-reset: number var(--num);\n\n    animation: countUp var(--seconds) ease-out forwards;\n  }\n\n  .custom-counter::after {\n    content: \"{{prefix}}\" counter(number) \"{{suffix}}\";\n  }\n\n  @keyframes countUp {\n    from {\n      --num: var(--start);\n    }\n\n    to {\n      --num: var(--end);\n    }\n  }\n</style>\n\n<div class=\"custom-counter\"></div>",
    "custom_vars": {
      "start": "1",
      "end": "10000",
      "seconds": "5",
      "color": "#22C55E",
      "font_size": "72",
      "prefix": "",
      "suffix": " + Users"
    },
    "is_builtin": false,
    "created_at": "2026-10-05T05:02:31.843278+00:00",
    "updated_at": "2026-10-05T05:02:31.843278+00:00"
  }
